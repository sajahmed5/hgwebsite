# ── Email delivery for the enquiry & job-application forms ──────────────
# Copy this file to ".env.local" for local dev, and add the same values in
# your host's dashboard (e.g. Vercel → Settings → Environment Variables).
#
# Without RESEND_API_KEY the forms still work — submissions are logged to the
# server console instead of emailed.

# 1) Sign up free at https://resend.com and create an API key:
RESEND_API_KEY=

# 2) Where enquiries should land (defaults to hello@hgcare.co.uk):
CONTACT_TO_EMAIL=hello@hgcare.co.uk

# 3) The "from" address. To use your own domain, verify hgcare.co.uk in
#    Resend, then set e.g. "HG Care <noreply@hgcare.co.uk>".
#    Until then you can leave this blank to use Resend's test sender.
CONTACT_FROM_EMAIL=

# ── Application database (Supabase) ────────────────────────────────────
# Job applications are also saved to a Supabase Postgres table so you can
# browse candidates and see language stats. Without these the form still
# works — applications are just emailed and not stored.
#
# Setup:
#   1) Create a free project at https://supabase.com
#   2) SQL Editor → paste & run the contents of supabase/schema.sql
#   3) Settings → API → copy the values below
#      (the service_role key is SECRET — server-side only, never exposed)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Admin area (/admin) ────────────────────────────────────────────────
# A single shared password that protects the in-site applications viewer at
# /admin. Pick a long, random passphrase. Without it, /admin is disabled.
ADMIN_PASSWORD=
